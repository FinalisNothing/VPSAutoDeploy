{
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "tag": "reality_in",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{VISION_UUID}}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none",
        "fallbacks": [
          {
            "dest": "{{XHTTP_REALITY_SOCK}}"
          }
        ]
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "{{NGINX_TLS_SOCK}}",
          "xver": 1,
          "serverNames": [
            "{{DIRECT_DOMAIN}}"
          ],
          "privateKey": "{{REALITY_PRIVATE_KEY}}",
          "shortIds": "{{REALITY_SHORT_IDS:json}}",
          "mldsa65Seed": "{{REALITY_MLDSA65_SEED}}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "xhttp_tls_in",
      "listen": "{{XHTTP_TLS_SOCK}},0666",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{XHTTP_TLS_UUID}}"
          }
        ],
        "decryption": "{{XHTTP_TLS_DECRYPTION}}"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/{{XHTTP_PATH}}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "xhttp_reality_in",
      "listen": "{{XHTTP_REALITY_SOCK}},0666",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{XHTTP_REALITY_UUID}}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/{{XHTTP_REALITY_PATH}}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ]
}
