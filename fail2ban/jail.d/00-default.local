# /etc/fail2ban/jail.d/00-default.local
# Defaults shared by every jail. fail2ban merges jail.d/*.local in name
# order, so each concern lives in its own drop-in and can be replaced
# independently:
#
#   00-default.local     this file - shared defaults
#   01-ignoreip.local    ignoreip - GENERATED by update-cloudflare-ips.sh,
#                        never edit it by hand. Permanent custom safe-list
#                        entries go into /etc/fail2ban/ignoreip.custom
#                        (one per line) and survive every regeneration.
#   10-sshd.local        rendered from 10-sshd.local.template by deploy.sh
#   20-nginx.local       nginx jails
#   30-recidive.local    repeat-offender escalation

[DEFAULT]

# --- Ban action: use UFW ---
# ufw action runs: ufw insert 1 deny from <ip> to any
# This blocks the IP from ALL ports (SSH, HTTP, HTTPS, etc.)
banaction = ufw
banaction_allports = ufw

# --- Default timing ---
bantime  = 1h
findtime = 10m
maxretry = 5

# --- Progressive ban (repeat offenders get longer bans) ---
bantime.increment = true
bantime.factor   = 2
bantime.maxtime  = 4w
bantime.formula  = ban.Time * math.exp(float(ban.Count+1)*banFactor)/math.exp(1*banFactor)

# --- Backend ---
# File-based jails (nginx) watch their logpath. The sshd jail overrides
# this with backend=systemd - see 10-sshd.local for why.
backend = auto

# Detect IPv6 support instead of warning about it at startup.
allowipv6 = auto
