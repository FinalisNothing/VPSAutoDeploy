{
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "blocked"
      },
      {
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "blocked"
      },
      {
        "domain": [
          "geosite:cn",
          "regexp:.*\\.cn$"
        ],
        "outboundTag": "blocked"
      },
      {
        "ip": [
          "geoip:private",
          "geoip:cn"
        ],
        "outboundTag": "blocked"
      }
    ]
  }
}
