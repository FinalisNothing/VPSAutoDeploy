worker_processes auto;

error_log /nginx/logs/error.log;

pid /nginx/logs/nginx.pid;

events {
    worker_connections 1024;
}

http {

    include mime.types;
    default_type application/octet-stream;

    map $proxy_protocol_addr $conn_src_ip {
        "" $remote_addr;
        default $proxy_protocol_addr;
    }

    geo $conn_src_ip $from_cf {
        default 0;
        include /nginx/conf/cloudflare-ips.geo;
    }
    map "$from_cf:$http_cf_connecting_ip" $client_ip {
        default $conn_src_ip;
        "~^1:(?<ip>.+)$" $ip;
    }

    upstream backend_web {
        server {{BACKEND_WEB}}:443;
        keepalive 16;
    }

    log_format main '$client_ip - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" "$host"';

    access_log /nginx/logs/access.log main;

    sendfile on;

    keepalive_timeout 65;

    # Brotli compression
    brotli on;
    brotli_comp_level 4;
    brotli_types text/plain text/css application/json application/javascript
                 text/xml application/xml text/javascript image/svg+xml;

    # General rate limit: 30 requests/second per IP
    limit_req_zone $client_ip zone=general:10m rate=30r/s;

    # Connection limit per IP
    limit_conn_zone $client_ip zone=conn_per_ip:10m;

    # ── HTTP → HTTPS redirect (direct domain) ──
    server {
        listen 80;
        server_name {{DIRECT_DOMAIN}};
        location /.well-known/acme-challenge/ {
            alias /nginx/acme_challenge/.well-known/acme-challenge/;
        }
        location ~ /\.(?!well-known) {
            return 444;
        }
        location ~* ^/(wp-config|xmlrpc|wp-login|phpmyadmin|pma|adminer|mysqladmin|cgi-bin|server-status|server-info|manager|actuator|swagger|graphql|telescope|jenkins|solr|SDK|boaform|remote/login|GponForm|HNAP1|dns-query|wordpress|geoserver|druid|hudson|xmrig|luci|nmaplowercheck|evox|setup\.cgi|ReportServer|developmentserver) {
            return 444;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ── SNI reject (default_server) ──
    server {
        listen unix:/dev/shm/uds8443.sock ssl proxy_protocol default_server;
        http2 on;
        set_real_ip_from unix:;
        real_ip_header proxy_protocol;
        ssl_reject_handshake on;
        ssl_protocols TLSv1.2 TLSv1.3;
    }

    # ── CDN domain (a.domain.com) ──
    server {
        listen unix:/dev/shm/uds8443.sock ssl proxy_protocol;
        http2 on;
        set_real_ip_from unix:;
        real_ip_header proxy_protocol;
        server_name {{CDN_DOMAIN}};
        ssl_certificate /home/{{USERNAME}}/xray_cert/{{CDN_DOMAIN}}/fullchain.pem;
        ssl_certificate_key /home/{{USERNAME}}/xray_cert/{{CDN_DOMAIN}}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;
        ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers on;
        ssl_ecdh_curve X25519MLKEM768:X25519;

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        location ~* ^/(\.env|\.git|\.svn|\.htaccess|\.htpasswd|wp-config\.php|xmlrpc\.php|wp-login\.php|phpmyadmin|pma|adminer|mysqladmin|cgi-bin|server-status|server-info|manager|actuator|swagger|graphql|telescope|jenkins|solr|SDK|boaform|remote/login|GponForm|HNAP1|dns-query|wordpress|geoserver|druid|hudson|xmrig|luci|nmaplowercheck|evox|setup\.cgi|ReportServer|developmentserver) {
            deny all;
            access_log off;
            log_not_found off;
        }

        # xhttp_tls_in
        location /{{XHTTP_PATH}} {
            grpc_pass grpc://unix:/dev/shm/uds2023.sock;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        error_page 502 /502.html;
        error_page 504 /504.html;

        location = /502.html {
            internal;
            root /nginx/html/errors;
        }

        location = /504.html {
            internal;
            root /nginx/html/errors;
        }

        # Reverse proxy to upstream web
        location / {
            limit_req zone=general burst=50 nodelay;
            limit_conn conn_per_ip 30;
            proxy_pass https://backend_web;
            proxy_http_version 1.1;
            proxy_set_header Host {{BACKEND_WEB}};
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_ssl_server_name on;
            proxy_ssl_name {{BACKEND_WEB}};
            proxy_ssl_protocols TLSv1.2 TLSv1.3;

            proxy_connect_timeout 10s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;

            proxy_hide_header Server;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        }

    }

    # ── Direct domain (b.domain.com) ──
    server {

        listen 443 quic reuseport;
        http3 on;
        listen unix:/dev/shm/uds8443.sock ssl proxy_protocol;
        http2 on;
        set_real_ip_from unix:;
        real_ip_header proxy_protocol;
        server_name {{DIRECT_DOMAIN}};
        ssl_certificate /home/{{USERNAME}}/xray_cert/{{DIRECT_DOMAIN}}/fullchain.pem;
        ssl_certificate_key /home/{{USERNAME}}/xray_cert/{{DIRECT_DOMAIN}}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_ecdh_curve X25519MLKEM768:X25519;
        ssl_prefer_server_ciphers on;

        error_page 502 /502.html;
        error_page 504 /504.html;

        location = /502.html {
            internal;
            root /nginx/html/errors;
        }

        location = /504.html {
            internal;
            root /nginx/html/errors;
        }

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        location ~* ^/(\.env|\.git|\.svn|\.htaccess|\.htpasswd|wp-config\.php|xmlrpc\.php|wp-login\.php|phpmyadmin|pma|adminer|mysqladmin|cgi-bin|server-status|server-info|manager|actuator|swagger|graphql|telescope|jenkins|solr|SDK|boaform|remote/login|GponForm|HNAP1|dns-query|wordpress|geoserver|druid|hudson|xmrig|luci|nmaplowercheck|evox|setup\.cgi|ReportServer|developmentserver) {
            deny all;
            access_log off;
            log_not_found off;
        }

        # xhttp_tls_in
        location /{{XHTTP_PATH}} {
            grpc_pass grpc://unix:/dev/shm/uds2023.sock;
            grpc_set_header Host $host;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # CLIProxyAPI
        location /{{CLIPROXY_PATH}}/ {
            brotli off;
            proxy_pass http://127.0.0.1:8888;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_hide_header Server;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_connect_timeout 300s;
            client_max_body_size 10m;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        }

        # 3x-ui web panel
        location /{{XUI_PANEL_PATH}}/ {
            brotli off;
            proxy_pass http://127.0.0.1:{{XUI_PANEL_PORT}};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Reverse proxy to upstream web
        location / {
            limit_req zone=general burst=50 nodelay;
            limit_conn conn_per_ip 30;
            proxy_pass https://backend_web;
            proxy_http_version 1.1;
            proxy_set_header Host {{BACKEND_WEB}};
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_ssl_server_name on;
            proxy_ssl_name {{BACKEND_WEB}};
            proxy_ssl_protocols TLSv1.2 TLSv1.3;

            proxy_connect_timeout 10s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;

            proxy_hide_header Server;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        }
    }
}
