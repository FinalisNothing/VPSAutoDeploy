{
  "log": {
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "e2e_in",
      "listen": "0.0.0.0",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{UUID}}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "{{SNI}}:443",
          "serverNames": [
            "{{SNI}}"
          ],
          "privateKey": "{{PRIVATE_KEY}}",
          "shortIds": [
            ""
          ]
        }
      }
    }
  ]
}
